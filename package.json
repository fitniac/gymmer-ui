{
  "name": "@gymmer/ui",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "Gymmer design system as a Nuxt 4 layer \u2014 tokens, theme, and shared component classes",
  "scripts": {
    "test:contrast": "node --test test/contrast.test.mjs",
    "test": "node --test test/contrast.test.mjs test/css-layers.test.mjs",
    "brand": "node scripts/generate-brand.mjs && node scripts/verify-brand.mjs",
    "brand:verify": "node scripts/verify-brand.mjs",
    "test:layers": "node --test test/css-layers.test.mjs",
    "css:audit": "node scripts/css-layers.mjs app/assets/css/tokens.css app/assets/css/gymmer.css"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.11.4"
  },
  "devDependencies": {
    "nuxt": "^4.0.1"
  },
  "packageManager": "pnpm@10.33.2"
}
